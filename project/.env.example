# 复制此文件为 .env，填入你的实际配置

# 共享配置（所有脚本的默认值）
LLM_API_KEY=
LLM_API_BASE=
LLM_MODEL=

# RAG 引擎专用（不设则使用上面的共享值）
# RAG_API_KEY=
# RAG_API_BASE=
# RAG_MODEL=

# Embedding / Reranker 计算后端：local 或 remote
RAG_QA_COMPUTE_BACKEND=local
RAG_QA_EMBEDDING_MODEL=BAAI/bge-large-zh-v1.5
RAG_QA_RERANKER_MODEL=BAAI/bge-reranker-base
RAG_QA_DEVICE=auto

# remote 模式需要填写；非 localhost 地址必须设置 token
# RAG_QA_REMOTE_URL=http://100.x.y.z:8765
# ASCII only; generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# RAG_QA_WORKER_TOKEN=replace-with-a-long-random-token
# RAG_QA_REMOTE_TIMEOUT=120
# RAG_QA_QUERY_FALLBACK_TO_LOCAL=false

# RAGAS 评估专用（不设则使用上面的共享值）
# RAGAS_API_KEY=
# RAGAS_API_BASE=
# RAGAS_MODEL=
